# ==============================================================================
# AWS DAS Processor - Environment Variables Configuration
# ==============================================================================

# Directory containing YAML filter rule files (default: filters or ${LAMBDA_TASK_ROOT}/filters)
DAS_FILTERS_DIR=filters

# Fallback RDS Resource ID (e.g. cluster-EXAMPLE1234567890ABCDEF or db-ABCDEFGHIJKLMNOPQRSTUVWXYZ).
# Dynamically extracted from S3 object key paths if the key contains "cluster-*" or "db-*".
DAS_RDS_RESOURCE_ID=

# AWS Region for KMS Customer Managed Key (CMK) envelope decryption.
# Defaults to the Lambda ambient execution region (AWS_REGION).
DAS_KMS_REGION_NAME=us-east-1

# Destination S3 analytical bucket for writing processed Parquet files.
# If unset, defaults to the incoming source S3 bucket.
DAS_OUTPUT_BUCKET=my-analytical-parquet-bucket

# Partitioning layout format in destination S3: "hive" | "date" | "mirrored" (default: hive).
DAS_OUTPUT_FORMAT=hive

# Base directory prefix in destination S3 bucket (default: "das").
DAS_OUTPUT_PREFIX=das

# Whether to include /<filter-name>/ in the destination S3 path (true | false, default: false).
# Recommended true when running multiple filter configurations.
DAS_OUTPUT_INCLUDE_FILTER=false

# Optional AWS KMS Key ID or ARN to enforce SSE-KMS encryption on destination Parquet files.
DAS_OUTPUT_KMS_KEY_ID=

# AWS Encryption SDK raw AES Keyring Key Name (default: DataKey).
DAS_KEY_NAME=DataKey

# Optional custom AWS Encryption SDK Key Provider Namespace.
# Processor MultiKeyring defaults to "BC" (standard AWS RDS BouncyCastle) and "RawMasterKeyProvider".
DAS_KEY_NAMESPACE=
